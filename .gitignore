.venv/
__pycache__/
*.pyc
.pytest_cache/
uv.lock.bak

# Derived — rebuilt by data/build_table.py from the two source CSVs.
data/modeling_table.csv

# Not derived, never ignore: data/dam_levels.csv and data/weather.csv are the
# collected record. PAGASA keeps no archive, so a lost row is lost forever.

# Local screenshots / browser scratch
*.png
!web/public/*.png
.playwright-mcp/

# Model state: a Mondrian forest grows a node per observation, so this
# reaches ~88 MB and keeps going. It is cached by the Action and rebuilt
# from the committed history on a miss (eval/backtest.py), so nothing is
# lost by keeping it out of git.
model/state/*.pkl
model/state/*.tmp
